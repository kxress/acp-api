{
  "server": {
    "host": "127.0.0.1",
    "port": 11435,
    "api_key": "${ACP_API_KEY:-local-development-token}",
    "routing_strategy": "sticky_failover",
    "max_retries": 1,
    "max_sessions": 32
  },
  "agents": [
    {
      "name": "example-agent",
      "instance_id": "example-agent-a",
      "command": "opencode",
      "args": ["acp"],
      "models": ["local-model"],
      "permission": "deny"
    }
  ]
}
