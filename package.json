{
  "name": "acp-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#fs": "./src/runtime/node_fs.ts",
    "#proc": "./src/runtime/node_process.ts"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "bin": {
    "acp-api": "dist/acp-api.mjs"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "biome lint src scripts",
    "test": "node --test",
    "format": "biome format --write src scripts README.md docs examples",
    "format:check": "biome format src scripts README.md docs examples",
    "build": "node scripts/build.ts",
    "start": "node dist/acp-api.mjs --config config.json"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/node": "24.19.2",
    "esbuild": "0.27.3",
    "typescript": "5.9.3"
  }
}
